{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "ConnectionStrings": {
    "Ledger": ""
  },
  "Outbox": {
    "LeaseDuration": "00:00:30",
    "BatchSize": 50,
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "PollInterval": "00:00:01",
    "SimulatedSink": {
      "FailureRate": 0.0
    }
  },
  "Worker": {
    "IdempotencyCleanupInterval": "01:00:00",
    "ReconciliationInterval": "00:15:00",
    "FreezeWalletsOnReconciliationMismatch": true
  },
  "WorkerFailureInjection": {
    "KillAfterDeliveries": 0
  }
}
