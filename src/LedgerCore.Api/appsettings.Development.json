{
  // DEVELOPMENT ONLY. The values below are throwaway demo credentials for a local database and a local
  // token signer. They are not production secrets, and the API refuses to enable DevAuthentication,
  // FailureInjection or SimulatedFunding in any environment other than Development or Testing.
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=ledgercore;Username=ledgercore;Password=ledgercore_dev_only"
  },
  "DevAuthentication": {
    "Enabled": true,
    "Issuer": "ledgercore-dev",
    "Audience": "ledgercore-api",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
    "TokenLifetime": "01:00:00"
  },
  "FailureInjection": {
    "Enabled": true
  },
  "Features": {
    "SimulatedFunding": true
  },
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoDataOnStartup": true
  },
  // Relaxed so the concurrency demos (100 parallel requests from one user) are not throttled.
  // Production defaults are in appsettings.json; 429 behaviour is covered by SecurityConfigurationTests.
  "RateLimiting": {
    "TransferPermitsPerSecond": 2000,
    "TransferBurst": 2000,
    "GeneralPermitsPerMinute": 100000,
    "DevTokensPerMinute": 600
  }
}
