{
  // Production-safe defaults. Nothing here is a secret; secrets come from environment variables or a
  // secret store. Development-only features are OFF and refuse to start outside Development/Testing.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ledger": ""
  },
  "Authentication": {
    "Jwt": {
      "Authority": "",
      "Audience": "ledgercore-api"
    }
  },
  "DevAuthentication": {
    "Enabled": false
  },
  "FailureInjection": {
    "Enabled": false
  },
  "Features": {
    "SimulatedFunding": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoDataOnStartup": false
  },
  "Ledger": {
    "LockTimeout": "00:00:05",
    "MaxTransactionAttempts": 4,
    "RetryBaseDelay": "00:00:00.020"
  },
  "Idempotency": {
    "Retention": "1.00:00:00"
  },
  "Wallets": {
    "MaxWalletsPerCustomer": 10
  },
  "RateLimiting": {
    "TransferPermitsPerSecond": 10,
    "TransferBurst": 20,
    "GeneralPermitsPerMinute": 600,
    "DevTokensPerMinute": 20
  }
}
