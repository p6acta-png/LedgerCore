# Copy to .env to override the docker-compose development defaults. .env is git-ignored.
# These are LOCAL DEMO values; never reuse them anywhere real.
LEDGERCORE_DB_PASSWORD=choose-a-local-password
LEDGERCORE_DEV_SIGNING_KEY=choose-a-random-string-of-at-least-32-characters

# Uncomment together with `docker compose --profile observability up` to export telemetry.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889
